// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts_web")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions_web")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  discordId     String?   @unique
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users_web")
}

model Staff {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  discordId String              @unique
  role      StaffRole
  isInTeam  Boolean             @default(true)
  create    AuthorizationType[] @default([])
  edit      AuthorizationType[] @default([])
  delete    AuthorizationType[] @default([])
  handle    AuthorizationType[] @default([])
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  createdEvents         Events[]        @relation("event_createdBy")
  createdPendingIssues  PendingIssues[] @relation("PendingIssuesCreatedBy")
  approvedPendingIssues PendingIssues[] @relation("PendingIssuesApprovedBy")
  rejections            Rejections[]    @relation("RejectionsRejectedBy")
  resubmittedRejections Rejections[]    @relation("RejectionsResubmittedBy")
  approvedIssues        Issues[]        @relation("IssuesApprovedBy")
  createdIssues         Issues[]        @relation("IssuesCreatedBy")

  @@map("staff")
}

enum AuthorizationType {
  issues
  staff
  event
}

enum StaffRole {
  owner
  moderator
  regularDesigner
  customDesigner
  host
  supportStaff
}

model Cards {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  era    String
  group  String
  rarity Json
  code   String   @unique
  image  String
  date   DateTime
  owner  String
  issue  String

  @@map("cards")
}

model Issues {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  era          String
  group        String
  rarity       Int
  code         String   @unique
  image        String
  dropAble     Boolean
  createdAt    DateTime
  updatedAt    DateTime @updatedAt
  eventId      String   @db.ObjectId
  createdById  String   @db.ObjectId
  approvedById String   @db.ObjectId
  approvedAt   DateTime

  rejections Rejections[] @relation("RejectionsIssue")
  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "IssuesCreatedBy")
  approvedBy Staff        @relation(fields: [approvedById], references: [id], name: "IssuesApprovedBy")
  event      Events       @relation(fields: [eventId], references: [id], name: "IssuesEvent")

  @@map("issues")
}

model PendingIssues {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  era          String
  group        String
  rarity       Int
  code         String    @unique
  image        String
  eventId      String    @db.ObjectId
  dropAble     Boolean
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String    @db.ObjectId
  approvedById String?   @db.ObjectId
  approvedAt   DateTime?

  createdBy  Staff        @relation(fields: [createdById], references: [id], name: "PendingIssuesCreatedBy")
  approvedBy Staff?       @relation(fields: [approvedById], references: [id], name: "PendingIssuesApprovedBy")
  event      Events       @relation(fields: [eventId], references: [id], name: "PendingIssuesEvent")
  rejections Rejections[] @relation("RejectionsPendingIssue")

  @@map("pending_issues")
}

model Events {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  name             String      @unique
  start            DateTime
  end              DateTime
  itemsReleaseType ItemsType[]
  createdById      String      @db.ObjectId
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  createdBy     Staff           @relation(fields: [createdById], references: [id], name: "event_createdBy")
  pendingIssues PendingIssues[] @relation("PendingIssuesEvent")
  issues        Issues[]        @relation("IssuesEvent")

  @@map("events")
}

enum ItemsType {
  issues
}

model Rejections {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  reason          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rejectedById    String    @db.ObjectId
  resubmitted     Boolean   @default(false)
  resubmittedAt   DateTime?
  resubmittedById String?   @db.ObjectId
  issuesId        String?   @db.ObjectId
  pendingIssuesId String?   @db.ObjectId

  rejectedBy    Staff          @relation(fields: [rejectedById], references: [id], name: "RejectionsRejectedBy")
  resubmittedBy Staff?         @relation(fields: [resubmittedById], references: [id], name: "RejectionsResubmittedBy")
  issues        Issues?        @relation(fields: [issuesId], references: [id], name: "RejectionsIssue")
  pendingIssues PendingIssues? @relation(fields: [pendingIssuesId], references: [id], name: "RejectionsPendingIssue")

  @@map("rejections")
}
